# The OAuth 2.0 authorization server this RS trusts. Also advertised in the
# RFC 9728 metadata's authorization_servers.
AS_ISSUER=https://authlete-as.vercel.app

# Override the RFC 7662 introspection endpoint. Defaults to ${AS_ISSUER}/oauth/introspect.
# INTROSPECTION_ENDPOINT=

# Credential the RS presents to the introspection endpoint. A bare value is sent
# as "Bearer <value>"; include a scheme (Basic/Bearer) to send verbatim.
RS_CREDENTIAL=demo-rs-credential

# This RS's own canonical origin (its identity + metadata base). No trailing slash.
# On Vercel, falls back to VERCEL_URL; locally to http://localhost:PORT.
RESOURCE_URL=http://localhost:8090

# CORS allowlist (comma-separated). "*" = any (dev only); empty = disabled.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5199

PORT=8090
NODE_ENV=development
