# The OAuth 2.0 authorization server this RS trusts. Advertised in the RFC 9728
# metadata's authorization_servers.
AS_ISSUER=https://authlete-as.vercel.app

# Authlete API — the RS introspects access tokens directly against Authlete so it
# can verify request signatures and learn when a response must be signed.
AUTHLETE_BASE_URL=https://us.authlete.com
AUTHLETE_SERVICE_ID=
AUTHLETE_API_TOKEN=

# Required. Private JWK (ES256) for signing resource responses; its public half
# is published at /api/jwks for clients to verify against. Generate one with
# `npm run gen:key` and paste the printed line here. Keep it out of version
# control (this .env is gitignored).
RESPONSE_SIGNING_JWK=

# This RS's own canonical origin (its identity + metadata base). No trailing slash.
# On Vercel, falls back to VERCEL_URL; locally to http://localhost:PORT.
RESOURCE_URL=http://localhost:8090

# CORS allowlist (comma-separated). "*" = any (dev only); empty = disabled.
# Include the https origin too — FAPI clients run the playground over https.
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:5199

PORT=8090
NODE_ENV=development
