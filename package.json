{
  "name": "typescript-resource-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OAuth 2.0 protected resource server (RFC 9728 / RFC 6750 / RFC 7662), built on Hono",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env src/dev.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/dev.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "tsc",
    "gen:key": "node scripts/gen-signing-key.mjs"
  },
  "dependencies": {
    "@authlete/typescript-sdk": "^2.0.1",
    "@hono/swagger-ui": "^0.6.1",
    "fetch-message-signatures": "^0.1.2",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hono/node-server": "^1.13.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
